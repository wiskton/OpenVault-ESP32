# QinHeng USB bridge used by M5StickC PLUS2. Grant the active local session access.
# Run before 73-seat-late.rules so uaccess applies to the current device event.
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="openvault-panel.service"
